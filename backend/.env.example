# Runtime: use Neon's pooled connection string for DATABASE_URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require&pgbouncer=true"

# Migrations: use Neon's direct (non-pooler) connection string for DIRECT_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require"

# Set a strong bootstrap password before first deployment.
ADMIN_INITIAL_PASSWORD="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# Comma-separated exact frontend origins, with no trailing slash.
CORS_ORIGINS="https://YOUR-VERCEL-DOMAIN.vercel.app"
