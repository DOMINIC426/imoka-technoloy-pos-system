generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  admin
  cashier
}

model User {
  id                 String       @id @default(uuid()) @db.Uuid
  firstName          String       @db.VarChar(80)
  lastName           String       @db.VarChar(80)
  email              String       @unique @db.VarChar(254)
  role               UserRole     @default(cashier)
  passwordSalt       String       @db.VarChar(64)
  passwordHash       String       @db.VarChar(128)
  mustChangePassword Boolean      @default(false)
  createdAt          DateTime     @default(now()) @db.Timestamptz(3)
  sessions           Session[]
  shifts             Shift[]
  sales              Sale[]
  auditEvents        AuditEvent[]

  @@index([role, createdAt])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @db.VarChar(64)
  userId    String   @db.Uuid
  shiftId   String?  @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shift     Shift?   @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt])
  @@index([shiftId])
}

model Product {
  id           String     @id @default(uuid()) @db.Uuid
  sku          String     @unique @db.VarChar(40)
  name         String     @db.VarChar(160)
  category     String     @db.VarChar(32)
  price        Decimal    @db.Decimal(12, 2)
  stockTracked Boolean    @default(true)
  stock        Int        @default(0)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)
  saleItems    SaleItem[]

  @@index([active, name])
  @@index([category])
}

model Shift {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  openedAt  DateTime  @default(now()) @db.Timestamptz(3)
  closedAt  DateTime? @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  sales     Sale[]
  sessions  Session[]

  @@index([userId, openedAt])
  @@index([closedAt])
}

model Sale {
  id           String     @id @default(uuid()) @db.Uuid
  clientSaleId String     @db.VarChar(120)
  receiptNo    String     @db.VarChar(80)
  cashierId    String     @db.Uuid
  shiftId      String?    @db.Uuid
  customerName String     @default("") @db.VarChar(160)
  payment      String     @db.VarChar(40)
  subtotal     Decimal    @db.Decimal(12, 2)
  discount     Decimal    @default(0) @db.Decimal(12, 2)
  tax          Decimal    @default(0) @db.Decimal(12, 2)
  total        Decimal    @db.Decimal(12, 2)
  paid         Decimal    @default(0) @db.Decimal(12, 2)
  change       Decimal    @default(0) @db.Decimal(12, 2)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  cashier      User       @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  shift        Shift?     @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  items        SaleItem[]

  @@unique([cashierId, clientSaleId])
  @@index([createdAt])
  @@index([shiftId, createdAt])
  @@index([cashierId, createdAt])
}

model SaleItem {
  id        String   @id @default(uuid()) @db.Uuid
  saleId    String   @db.Uuid
  productId String?  @db.Uuid
  name      String   @db.VarChar(160)
  price     Decimal  @db.Decimal(12, 2)
  quantity  Int
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([productId])
}

model AuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  actorName String   @db.VarChar(170)
  action    String   @db.VarChar(80)
  entity    String   @db.VarChar(40)
  entityId  String?  @db.VarChar(120)
  details   Json     @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([actorId, createdAt])
}
